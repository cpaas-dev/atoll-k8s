FROM ubuntu:22.04

RUN  apt update -y \
  && apt install -y uidmap fuse-overlayfs \
  && rm -rf /var/lib/apt/lists/*

COPY atoll /usr/bin/

# nosemgrep: dockerfile.security.missing-user.missing-user
ENTRYPOINT ["/usr/bin/atoll"]
# nosemgrep: dockerfile.security.missing-user.missing-user
CMD ["--help"]
